+/*
+ * Keep only the variant with the highest bandwidth not above max_bandwidth
+ * (or the lowest one if none fits) and the playlists it uses, so the other
+ * variants are never downloaded.
+ */
+static void select_single_variant(HLSContext *c)
+{
+    struct variant *sel = NULL;
+    int i, j, n;
+
+    for (i = 0; i < c->n_variants; i++) {
+        struct variant *var = c->variants[i];
+        int fits     = !c->max_bandwidth || var->bandwidth <= c->max_bandwidth;
+        int sel_fits = sel && (!c->max_bandwidth || sel->bandwidth <= c->max_bandwidth);
+
+        if (!sel || (fits && (!sel_fits || var->bandwidth > sel->bandwidth)) ||
+            (!fits && !sel_fits && var->bandwidth < sel->bandwidth))
+            sel = var;
+    }
+
+    for (i = 0; i < c->n_variants; i++) {
+        if (c->variants[i] != sel) {
+            av_freep(&c->variants[i]->playlists);
+            av_freep(&c->variants[i]);
+        }
+    }
+    c->variants[0] = sel;
+    c->n_variants  = 1;
+
+    for (i = 0, n = 0; i < c->n_playlists; i++) {
+        struct playlist *pls = c->playlists[i];
+        int keep = pls == sel->playlists[0];
+
+        for (j = 0; j < c->n_renditions && !keep; j++)
+            keep = c->renditions[j]->playlist == pls && rendition_in_variant(c->renditions[j], sel);
+
+        if (keep)
+            c->playlists[n++] = pls;
+        else
+            free_playlist(c, pls);
+    }
+    c->n_playlists = n;
+
+    /* Drop the renditions whose playlist was freed above */
+    for (i = 0, n = 0; i < c->n_renditions; i++) {
+        struct rendition *rend = c->renditions[i];
+        int keep = !rend->playlist;
+
+        for (j = 0; j < c->n_playlists && !keep; j++)
+            keep = rend->playlist == c->playlists[j];
+
+        if (keep)
+            c->renditions[n++] = rend;
+        else
+            av_free(rend);
+    }
+    c->n_renditions = n;
+}
